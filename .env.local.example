# Supabase — create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Billplz — sandbox credentials from https://www.billplz-sandbox.com
BILLPLZ_API_KEY=your-billplz-api-key
BILLPLZ_COLLECTION_ID=your-collection-id
BILLPLZ_X_SIGNATURE=your-x-signature
NEXT_PUBLIC_BILLPLZ_SANDBOX=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
